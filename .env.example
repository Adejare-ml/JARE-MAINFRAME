# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# VITE_-prefixed variables are compiled into the browser bundle and are readable
# by anyone who loads the site. That is by design for these three: the Supabase
# anon key is protected by row-level security, and the Google client ID by the
# OAuth consent screen's test-user list. Never give a VITE_ prefix to anything
# that is not safe to publish.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Background sync (GitHub Actions secrets) ───────────────────────────────
# These are never bundled. Set them under
# Settings → Secrets and variables → Actions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SUPABASE_URL=
# Service role key -- full database access, bypasses row-level security.
SUPABASE_SERVICE_KEY=
# Whose rows the scheduled scripts write. Optional while the project has
# exactly one account (the scripts look it up); required the moment it has
# more:  select id, email from auth.users;
OWNER_USER_ID=

# ── Morning reminder (scripts/remind.mjs) ──────────────────────────────────
# Set to 1 to print the digest without sending. Sending itself arrives with
# push subscriptions; until then every run only prints.
# REMIND_DRY_RUN=1
# Days of ledger to scan for recurring bills. Default 120.
# REMIND_LOOKBACK_DAYS=120

# ── LLM parsing ────────────────────────────────────────────────────────────
# At least one is required if any wallet uses parse_strategy 'llm'
# (Opay and PiggyVest do -- their alerts word money in and money out the same).
OLLAMA_API_KEY=
NVIDIA_API_KEY=

# Optional. Set as GitHub repository *variables* to swap a model without a code
# change. Defaults live in scripts/llm.mjs; verify them with
#   node scripts/test-llm.mjs
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gemma4:31b-cloud
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
