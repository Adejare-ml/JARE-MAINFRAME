# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# VITE_-prefixed variables are compiled into the browser bundle and are readable
# by anyone who loads the site. That is by design for these three: the Supabase
# anon key is protected by row-level security, and the Google client ID by the
# OAuth consent screen's test-user list. Never give a VITE_ prefix to anything
# that is not safe to publish.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# The VAPID *public* key, safe to publish: it only lets a browser check that
# a push came from this app's server. Generate the pair once with
#   node scripts/generate-vapid.mjs
# and keep the private half in the Actions secret VAPID_PRIVATE_KEY.
VITE_VAPID_PUBLIC_KEY=

# ── Scheduled jobs (GitHub Actions secrets) ────────────────────────────────
# These are never bundled. Set them under
# Settings → Secrets and variables → Actions.
#
# The three Google values are only for a manual run of the retired Gmail sync
# or day draft (a backfill with a fresh token). The scheduled path reads the
# mailbox through the Claude task and needs no Google token at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SUPABASE_URL=
# Service role key -- full database access, bypasses row-level security.
SUPABASE_SERVICE_KEY=
# Whose rows the scheduled scripts write. Optional while the project has
# exactly one account (the scripts look it up); required the moment it has
# more:  select id, email from auth.users;
OWNER_USER_ID=

# ── Morning reminder (scripts/remind.mjs) ──────────────────────────────────
# The VAPID pair from `node scripts/generate-vapid.mjs`. The public half is
# also VITE_VAPID_PUBLIC_KEY above; the private half is a secret and nothing
# else. Rotating the pair means every phone turns reminders off and on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services (mailto: or https:). Optional.
# VAPID_SUBJECT=mailto:you@example.com
# Set to 1 to print the digest and who would get it, without sending.
# REMIND_DRY_RUN=1
# Days of ledger to scan for recurring bills. Default 120.
# REMIND_LOOKBACK_DAYS=120

# ── LLM (GitHub Actions secrets) ───────────────────────────────────────────
# At least one is required by the month plan and the weekly recap: both
# record a failed run and stop when neither key is set. (The retired Gmail
# sync used them too, for wallets with parse_strategy 'llm'.)
OLLAMA_API_KEY=
NVIDIA_API_KEY=

# Optional. Set as GitHub repository *variables* to swap a model without a code
# change. Defaults live in scripts/llm.mjs; verify them with
#   node scripts/test-llm.mjs
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gemma4:31b-cloud
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=openai/gpt-oss-120b
