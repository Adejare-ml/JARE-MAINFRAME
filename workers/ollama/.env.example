# Copy to .env (git-ignored) next to worker.py and fill in. Never commit .env.
#
# The project URL and the anon key are the same public values the app uses
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY); the anon key only gets the
# request past the edge function gateway.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# The secret set with `supabase secrets set DIET_WORKER_TOKEN=...`. It lets this
# worker list photo meals and add Ollama estimates, and nothing else.
DIET_WORKER_TOKEN=
# Ollama on this laptop.
OLLAMA_URL=http://127.0.0.1:11434
# Optional: override the model chosen in Diet settings (default qwen3-vl:8b).
# OLLAMA_MODEL=
# How often to look for new photos, in seconds.
POLL_SECONDS=60
# The GPU's memory. The worker refuses a model whose files are larger than
# about 90% of this, because a model that spills into system RAM is slow.
VRAM_GB=8
